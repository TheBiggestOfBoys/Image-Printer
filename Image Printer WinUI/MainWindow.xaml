<Window
	x:Class="Image_Printer_WinUI.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Title="Image Printer">

	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

	<Grid Padding="{StaticResource PagePadding}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<CommandBar
			Grid.Row="0"
			DefaultLabelPosition="Right"
			IsOpen="False"
			OverflowButtonVisibility="Collapsed">
			<AppBarButton
				x:Name="OpenButton"
				Click="OpenButton_Click"
				Label="Open image"
				ToolTipService.ToolTip="Open image"
				AutomationProperties.Name="Open image">
				<AppBarButton.Icon>
					<FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8B9;"/>
				</AppBarButton.Icon>
			</AppBarButton>
			<AppBarButton
				x:Name="SaveButton"
				Click="SaveButton_Click"
				Label="Save as text"
				ToolTipService.ToolTip="Save as text"
				AutomationProperties.Name="Save as text">
				<AppBarButton.Icon>
					<FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74E;"/>
				</AppBarButton.Icon>
			</AppBarButton>
			<AppBarButton
				x:Name="OpenTextFile"
				Click="OpenTextFile_Click"
				IsEnabled="False"
				Label="Open text file"
				ToolTipService.ToolTip="Open the text file created by Save as text"
				AutomationProperties.Name="Open text file">
				<AppBarButton.Icon>
					<FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8E5;"/>
				</AppBarButton.Icon>
			</AppBarButton>
			<AppBarButton
				x:Name="CopyText"
				Click="CopyText_Click"
				Label="Copy text"
				ToolTipService.ToolTip="Copy text"
				AutomationProperties.Name="Copy text">
				<AppBarButton.Icon>
					<FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;"/>
				</AppBarButton.Icon>
			</AppBarButton>
		</CommandBar>

		<Grid Grid.Row="1" Margin="0,12,0,0" ColumnSpacing="16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="300"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Settings / paths / ASCII editor (GUI feature parity) -->
			<Border
				Grid.Column="0"
				Style="{StaticResource PreviewBorderStyle}"
				Padding="{StaticResource SettingsPanelPadding}">
				<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<StackPanel Spacing="4">
						<TextBlock Text="Settings" Style="{StaticResource SettingsHeaderTextStyle}"/>

						<TextBlock Text="Image path" Style="{StaticResource SettingsLabelTextStyle}"/>
						<TextBlock
							x:Name="ImagePathText"
							TextWrapping="WrapWholeWords"
							FontFamily="Consolas"
							FontSize="11"
							Opacity="0.85"
							Margin="{StaticResource SectionSpacing}"/>

						<TextBlock Text="Exported to" Style="{StaticResource SettingsLabelTextStyle}"/>
						<TextBlock
							x:Name="ExportPathText"
							TextWrapping="WrapWholeWords"
							FontFamily="Consolas"
							FontSize="11"
							Opacity="0.85"
							Margin="{StaticResource SectionSpacing}"/>

						<Grid ColumnSpacing="8" Margin="{StaticResource SectionSpacing}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="72"/>
							</Grid.ColumnDefinitions>
							<TextBlock
								Grid.Column="0"
								VerticalAlignment="Center"
								Style="{StaticResource SettingsLabelTextStyle}"
								Margin="0">
								<Run Text="Resolution"/>
							</TextBlock>
							<TextBox
								x:Name="PercentageBox"
								Grid.Column="1"
								Text="100"
								LostFocus="PercentageBox_LostFocus"
								AutomationProperties.Name="Resolution percent"/>
						</Grid>
						<Slider
							x:Name="ResolutionSlider"
							Minimum="1"
							Maximum="100"
							Value="100"
							StepFrequency="1"
							TickFrequency="10"
							IsThumbToolTipEnabled="True"
							ValueChanged="ResolutionValue_ValueChanged"
							Margin="{StaticResource SectionSpacing}"
							AutomationProperties.Name="Resolution"/>

						<CheckBox
							x:Name="InvertGrayscaleBox"
							Content="Invert grayscale"
							Checked="ToggleGrayScale"
							Unchecked="ToggleGrayScale"
							Margin="{StaticResource SectionSpacing}"
							AutomationProperties.Name="Invert grayscale"/>

						<TextBlock Text="ASCII characters" Style="{StaticResource SettingsHeaderTextStyle}" Margin="0,8,0,8"/>

						<Grid ColumnSpacing="8" Margin="{StaticResource SectionSpacing}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<ComboBox
								x:Name="AsciiSetComboBox"
								Grid.Column="0"
								HorizontalAlignment="Stretch"
								SelectionChanged="AsciiSetComboBox_SelectionChanged"
								AutomationProperties.Name="ASCII set"/>
							<Button
								x:Name="DefaultAsciiButton"
								Grid.Column="1"
								Click="DefaultAscii_Click"
								ToolTipService.ToolTip="Reload ASCII list from current set"
								AutomationProperties.Name="Reload ASCII characters">
								<FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72C;" FontSize="14"/>
							</Button>
						</Grid>

						<Border
							BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
							BorderThickness="1"
							CornerRadius="4"
							Padding="4"
							MaxHeight="220"
							Margin="{StaticResource SectionSpacing}">
							<ScrollViewer VerticalScrollBarVisibility="Auto">
								<StackPanel x:Name="AsciiCharsPanel" Spacing="4"/>
							</ScrollViewer>
						</Border>

						<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
							<Button
								x:Name="SubtractCharacterButton"
								Content="-"
								Width="40"
								Click="SubtractCharacter_Click"
								ToolTipService.ToolTip="Remove last ASCII character"
								AutomationProperties.Name="Remove last ASCII character"/>
							<Button
								x:Name="SyncButton"
								Click="SyncButton_Click"
								Width="40"
								ToolTipService.ToolTip="Apply ASCII characters to conversion"
								AutomationProperties.Name="Apply ASCII characters">
								<FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE895;" FontSize="14"/>
							</Button>
							<Button
								x:Name="AddCharacterButton"
								Content="+"
								Width="40"
								Click="AddCharacter_Click"
								ToolTipService.ToolTip="Add ASCII character"
								AutomationProperties.Name="Add ASCII character"/>
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</Border>

			<!-- Preview -->
			<Border Grid.Column="1" Style="{StaticResource PreviewBorderStyle}">
				<Grid>
					<Image
						x:Name="PreviewImage"
						Stretch="Uniform"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"/>
					<TextBlock
						x:Name="EmptyStateText"
						Text="Open an image to convert"
						Style="{StaticResource EmptyStateTextStyle}"
						Visibility="Collapsed"/>
				</Grid>
			</Border>
		</Grid>

		<InfoBar
			x:Name="StatusInfoBar"
			Grid.Row="2"
			Margin="0,12,0,0"
			IsOpen="False"
			IsClosable="True"/>
	</Grid>
</Window>
