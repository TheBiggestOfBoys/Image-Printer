<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>Image_Printer_WinUI</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;ARM64</Platforms>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsPackageType>MSIX</WindowsPackageType>
		<!-- Self-contained so Unpackaged F5 works without DeploymentManager/class registration issues -->
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
		<AppxBundle>Never</AppxBundle>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<!-- NEVER enable signing in this project for Store uploads. Signing with ImagePrinter_TemporaryKey
		     (CN=jrsco) rewrites Identity Publisher and PFN; Partner Center then rejects the package.
		     Use unpackaged F5 for daily work. Sideload: set -p:EnableSideloadSigning=true with a thumbprint. -->
		<AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
		<AppxPackageSigningEnabled Condition="'$(EnableSideloadSigning)' == 'true' and '$(PackageCertificateThumbprint)' != ''">True</AppxPackageSigningEnabled>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateTemporaryStoreCertificate>False</GenerateTemporaryStoreCertificate>
		<!-- Avoid failing Store builds when mspdbcmf.exe (VS symbols tool) is missing from the SDK. -->
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
		<StoreIdentityPublisher>CN=A519B659-ED57-43B1-8525-0358CED8D6F5</StoreIdentityPublisher>
	</PropertyGroup>

	<!-- VS Create App Packages wizard often re-sets AppxPackageSigningEnabled=True + CN=jrsco thumbprint.
	     Clear those before packaging unless EnableSideloadSigning=true (local sideload only). -->
	<Target Name="ForceUnsignedStoreIdentity" BeforeTargets="_GenerateAppxManifest;_GenerateAppxPackage;GenerateAppxPackage" Condition="'$(EnableSideloadSigning)' != 'true'">
		<PropertyGroup>
			<AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
			<PackageCertificateThumbprint />
			<PackageCertificateKeyFile />
		</PropertyGroup>
		<Message Importance="high" Text="MSIX packaging: signing disabled so Publisher stays $(StoreIdentityPublisher)." />
	</Target>

	<!-- Platform-specific RuntimeIdentifiers -->
	<PropertyGroup Condition="'$(Platform)' == 'x86'">
		<RuntimeIdentifier>win-x86</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)' == 'x64'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)' == 'ARM64'">
		<RuntimeIdentifier>win-arm64</RuntimeIdentifier>
	</PropertyGroup>

	<!-- Fallback for AnyCPU/Any CPU/empty platform - default to x64 to prevent neutral architecture error -->
	<PropertyGroup Condition="'$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU' or '$(Platform)' == ''">
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Assets\SplashScreen.scale-200.png" />
		<Content Include="Assets\SplashScreen.png" />
		<Content Include="Assets\LockScreenLogo.scale-200.png" />
		<Content Include="Assets\Square150x150Logo.scale-200.png" />
		<Content Include="Assets\Square150x150Logo.png" />
		<Content Include="Assets\Square44x44Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.png" />
		<Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
		<Content Include="Assets\StoreLogo.png" />
		<Content Include="Assets\Wide310x150Logo.scale-200.png" />
		<Content Include="Assets\Wide310x150Logo.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.WindowsAppSDK" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\.editorconfig" Link=".editorconfig" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Image Printer\Image Printer.csproj" />
		<ProjectReference Include="..\Image Printer.Video\Image Printer.Video.csproj" />
	</ItemGroup>
</Project>