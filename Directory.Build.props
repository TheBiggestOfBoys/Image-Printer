<Project>
  <PropertyGroup>
    <!-- Common target framework for all projects -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

    <!-- Windows platform settings -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <!-- Language settings - most projects use disable, can be overridden per project -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- Project folders use spaces; NuGet PackageId cannot. "Image Printer" → "Image.Printer". -->
    <PackageId>$([System.String]::Copy('$(MSBuildProjectName)').Replace(' ', '.'))</PackageId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
