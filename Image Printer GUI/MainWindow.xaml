<Window x:Class="Image_Printer_GUI.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:Image_Printer_GUI"
		mc:Ignorable="d"
		d:DataContext="{d:DesignInstance Type=local:MainWindow, IsDesignTimeCreatable=True}"
		ResizeMode="CanResize"
		MinWidth="720"
		MinHeight="480"
		Title="Image Printer"
		Height="520"
		Width="900">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Toolbar -->
		<Grid Grid.Row="0" Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
				<Label Content="Open image" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
				<Button x:Name="OpenButton"
						Click="OpenButton_Click"
						Height="44" Width="44"
						FontFamily="Segoe Fluent Icons"
						Content="&#xE8B9;"
						FontSize="28"
						ToolTip="Open image(s)"/>
			</StackPanel>

			<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
				<Label Content="Resolution" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
				<TextBlock Text="0%" VerticalAlignment="Center" Margin="0,0,4,0"/>
				<Slider x:Name="ResolutionValue"
						Width="180"
						Minimum="0.01"
						Maximum="1"
						Value="1"
						TickFrequency="0.05"
						IsSnapToTickEnabled="True"
						TickPlacement="BottomRight"
						SmallChange="0.01"
						LargeChange="0.05"
						VerticalAlignment="Center"
						ValueChanged="ResolutionValue_ValueChanged"/>
				<TextBlock Text="100%" VerticalAlignment="Center" Margin="4,0,8,0"/>
				<TextBox x:Name="PercentageBox"
						 Width="40"
						 Height="22"
						 Text="100"
						 VerticalAlignment="Center"
						 LostFocus="PercentageBox_LostFocus"/>
				<TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0"/>
			</StackPanel>

			<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
				<Label Content="Save as text" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
				<Button x:Name="SaveButton"
						Click="SaveButton_Click"
						Height="44" Width="44"
						FontFamily="Segoe Fluent Icons"
						Content="&#xE74E;"
						FontSize="28"
						ToolTip="Save as text"
						Margin="0,0,16,0"/>
				<Label Content="Open text file" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
				<Button x:Name="OpenTextFile"
						Click="OpenTextFile_Click"
						Height="44" Width="44"
						FontFamily="Segoe Fluent Icons"
						Content="&#xE8E5;"
						FontSize="28"
						ToolTip="Open text file"/>
			</StackPanel>
		</Grid>

		<!-- Paths -->
		<Grid Grid.Row="1" Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<DockPanel Grid.Column="0" Margin="0,0,8,0">
				<Label Content="Image Path:" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Top"/>
				<TextBlock x:Name="ImagePath"
						   TextWrapping="Wrap"
						   FontSize="10"
						   FontFamily="Lucida Console"
						   VerticalAlignment="Top"
						   Margin="4,6,0,0"/>
			</DockPanel>
			<DockPanel Grid.Column="1" Margin="8,0,0,0">
				<Label Content="Exported to:" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Top"/>
				<TextBlock x:Name="ExportPath"
						   TextWrapping="Wrap"
						   FontSize="10"
						   FontFamily="Lucida Console"
						   VerticalAlignment="Top"
						   Margin="4,6,0,0"/>
			</DockPanel>
		</Grid>

		<!-- Content: preview | actions | ASCII -->
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Preview + scrubber -->
			<Grid Grid.Column="0" Margin="0,0,12,0">
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0"
						BorderBrush="Black"
						BorderThickness="3"
						Background="#FFF8F8F8"
						Padding="4">
					<Image x:Name="ImagePreview"
						   Stretch="Uniform"
						   HorizontalAlignment="Stretch"
						   VerticalAlignment="Stretch"/>
				</Border>

				<StackPanel x:Name="FrameScrubberPanel"
							Grid.Row="1"
							Orientation="Horizontal"
							Margin="0,8,0,0"
							Visibility="Collapsed">
					<Button x:Name="PrevFrameButton"
							Content="&#xE76B;"
							FontFamily="Segoe Fluent Icons"
							Width="28" Height="28"
							Click="PrevFrameButton_Click"
							ToolTip="Previous frame"/>
					<Slider x:Name="FrameScrubSlider"
							Width="200"
							Minimum="0"
							Maximum="0"
							TickFrequency="1"
							IsSnapToTickEnabled="True"
							VerticalAlignment="Center"
							Margin="8,0"
							ValueChanged="FrameScrubSlider_ValueChanged"/>
					<Button x:Name="NextFrameButton"
							Content="&#xE76C;"
							FontFamily="Segoe Fluent Icons"
							Width="28" Height="28"
							Click="NextFrameButton_Click"
							ToolTip="Next frame"/>
					<TextBlock x:Name="FrameScrubLabel"
							   Text="Frame 1 / 1"
							   VerticalAlignment="Center"
							   Margin="8,0,0,0"
							   FontSize="11"/>
				</StackPanel>
			</Grid>

			<!-- Actions -->
			<StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Top" MinWidth="150">
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<Label Content="Open PDF" FontWeight="Bold" FontSize="12" Width="90" VerticalAlignment="Center"/>
					<Button x:Name="OpenPdfButton"
							FontFamily="Segoe Fluent Icons"
							Content="&#xE8A5;"
							Height="36" Width="36"
							FontSize="18"
							Click="OpenPdfButton_Click"
							ToolTip="Open PDF"
							IsEnabled="False"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<Label Content="Save as PDF" FontWeight="Bold" FontSize="12" Width="90" VerticalAlignment="Center"/>
					<Button x:Name="SavePdfButton"
							FontFamily="Segoe Fluent Icons"
							Content="&#xEA90;"
							Height="36" Width="36"
							FontSize="18"
							Click="SavePdfButton_Click"
							ToolTip="Save as PDF"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<Label Content="Text to image" FontWeight="Bold" FontSize="12" Width="90" VerticalAlignment="Center"/>
					<Button x:Name="TextToImageButton"
							FontFamily="Segoe Fluent Icons"
							Content="&#xE8A5;"
							Height="36" Width="36"
							FontSize="18"
							Click="TextToImageButton_Click"
							ToolTip="Text to image"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<Label Content="Open video" FontWeight="Bold" FontSize="12" Width="90" VerticalAlignment="Center"/>
					<Button x:Name="OpenVideoButton"
							FontFamily="Segoe Fluent Icons"
							Content="&#xE714;"
							Height="36" Width="36"
							FontSize="18"
							Click="OpenVideoButton_Click"
							ToolTip="Open video or GIF and scrub frames"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
					<Label Content="Export all" FontWeight="Bold" FontSize="12" Width="90" VerticalAlignment="Center"/>
					<Button x:Name="ExportAllFramesButton"
							FontFamily="Segoe Fluent Icons"
							Content="&#xE8B7;"
							Height="36" Width="36"
							FontSize="18"
							Click="ExportAllFramesButton_Click"
							ToolTip="Export all frames"
							IsEnabled="False"/>
				</StackPanel>
				<CheckBox x:Name="ReverseGrayscale"
						  Content="Invert grayscale"
						  FontWeight="Bold"
						  FontSize="13"
						  Checked="UpdateGrayscale"
						  Unchecked="UpdateGrayscale"/>
			</StackPanel>

			<!-- ASCII -->
			<Grid Grid.Column="2">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
					<Label Content="ASCII Characters:" FontWeight="Bold" VerticalAlignment="Center"/>
					<Button x:Name="DefaultASCII"
							Content="&#xE72C;"
							FontFamily="Segoe MDL2 Assets"
							FontSize="14"
							Width="28" Height="28"
							Click="DefaultASCII_Click"
							ToolTip="Reload ASCII list"
							Margin="8,0,0,0"/>
				</StackPanel>

				<ListBox x:Name="ASCIIcharsBox"
						 Grid.Row="1"
						 Grid.Column="0"
						 Width="64"
						 Margin="0,0,8,0"
						 HorizontalContentAlignment="Center">
					<TextBox Text="#" Width="25" FontSize="20" MaxLength="1"/>
				</ListBox>

				<Menu x:Name="ASCIISetPicker"
					  Grid.Row="1"
					  Grid.Column="1"
					  VerticalAlignment="Top"
					  FontSize="14">
					<MenuItem Header="Default" Click="MenuItem_Click"/>
				</Menu>

				<Button x:Name="CopyText"
						Grid.Row="1"
						Grid.Column="2"
						FontFamily="Segoe Fluent Icons"
						Content="&#xE8C8;"
						Height="44" Width="44"
						FontSize="28"
						Click="CopyText_Click"
						ToolTip="Copy text"
						VerticalAlignment="Top"
						Margin="8,0,0,0"/>

				<StackPanel Grid.Row="2"
							Grid.Column="0"
							Orientation="Horizontal"
							HorizontalAlignment="Center"
							Margin="0,8,0,0">
					<Button x:Name="SubtractCharacter"
							Content="-"
							Width="24" Height="24"
							Click="SubtractCharacter_Click"
							FontSize="14"/>
					<Button x:Name="SyncButton"
							Content="&#xE895;"
							FontFamily="Segoe MDL2 Assets"
							FontSize="14"
							Width="24" Height="24"
							Click="SyncButton_Click"
							Margin="6,0"
							ToolTip="Apply ASCII characters"/>
					<Button x:Name="AddCharacter"
							Content="+"
							Width="24" Height="24"
							Click="AddCharacter_Click"
							FontSize="14"/>
				</StackPanel>
			</Grid>
		</Grid>

		<!-- Status -->
		<StackPanel Grid.Row="3" Margin="0,8,0,0">
			<TextBlock x:Name="VideoExportProgressText"
					   FontSize="11"
					   Visibility="Collapsed"
					   Margin="0,0,0,4"/>
			<ProgressBar x:Name="VideoExportProgressBar"
						 Height="12"
						 Minimum="0"
						 Maximum="100"
						 Value="0"
						 Visibility="Collapsed"/>
		</StackPanel>
	</Grid>
</Window>
